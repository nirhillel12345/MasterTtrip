// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
}

enum ListingType {
  LOOKING_FOR
  HAS_APARTMENT
}

enum AttractionType {
  BUSINESS
  PRIVATE
}

/// Pending email OTP for password sign-up; cleared after successful verification.
model VerificationToken {
  id         String   @id @default(cuid())
  email      String   @unique
  token      String
  expiresAt  DateTime
  /// Supabase Auth user id (`auth.users.id`) — required to confirm email via Admin API.
  authUserId String
  createdAt  DateTime @default(now())
}

model User {
  id                    String          @id @default(cuid())
  email                 String          @unique
  emailVerified         Boolean         @default(false)
  verificationCode      String?
  verificationCodeSentAt DateTime?
  verificationCodeExpiresAt DateTime?
  name                  String?
  image                 String?
  bio                   String?         @db.Text
  instagram             String?
  phone                 String?
  isPremium             Boolean         @default(false)
  listings              Listing[]
  transports            Transport[]     @relation("TransportCreator")
  transportJoins        TransportJoin[]
  attractions           Attraction[]    @relation("AttractionCreator")
  attractionJoins       AttractionJoin[]
  notificationsReceived Notification[]  @relation("NotificationRecipient")
  notificationsCreated  Notification[]  @relation("NotificationActor")
}

/// Canonical destination label from travel-destinations (e.g. "עיר, מדינה").
model Location {
  id          String       @id @default(cuid())
  label       String       @unique
  createdAt   DateTime     @default(now())
  attractions Attraction[]
}

model Listing {
  id              String      @id @default(cuid())
  createdAt       DateTime    @default(now())
  title           String
  description     String
  location        String
  type            ListingType
  price           Float
  startDate       DateTime
  endDate         DateTime
  whatsappNumber  String
  roommatesNeeded Int
  images          String[]    @default([])
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transport {
  id             String          @id @default(cuid())
  createdAt      DateTime        @default(now())
  creatorId      String
  creator        User            @relation("TransportCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  origin         String
  destination    String
  date           DateTime
  totalSeats     Int
  availableSeats Int
  pricePerPerson Float
  description    String          @db.Text
  joins          TransportJoin[]
  notifications  Notification[]
}

model TransportJoin {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  transportId String
  userId      String
  transport   Transport @relation(fields: [transportId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([transportId, userId])
}

model Attraction {
  id                String          @id @default(cuid())
  createdAt         DateTime        @default(now())
  title             String
  description       String?         @db.Text
  price             Float?
  locationId        String
  location          Location        @relation(fields: [locationId], references: [id], onDelete: Restrict)
  creatorId         String
  creator           User            @relation("AttractionCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  type              AttractionType
  images            String[]        @default([])
  contactPhone      String
  externalLink      String?
  date              DateTime?
  maxParticipants   Int?
  /// Remaining slots for PRIVATE attractions with a capacity; mirrors Transport.availableSeats.
  availableSlots    Int?
  joins             AttractionJoin[]
  notifications     Notification[]
}

model AttractionJoin {
  id           String     @id @default(cuid())
  createdAt    DateTime   @default(now())
  attractionId String
  userId       String
  attraction   Attraction @relation(fields: [attractionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([attractionId, userId])
}

model Notification {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  recipientId String
  actorId     String?
  transportId String?
  attractionId String?
  type        String
  title       String
  message     String    @db.Text
  readAt      DateTime?
  metadata    Json?
  recipient   User      @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor       User?     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  transport   Transport? @relation(fields: [transportId], references: [id], onDelete: SetNull)
  attraction  Attraction? @relation(fields: [attractionId], references: [id], onDelete: SetNull)
}
